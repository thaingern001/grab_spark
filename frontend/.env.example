GRABSPARK_API_BASE_URL=http://127.0.0.1:8000
# Generate with: cd ../backend; .venv\Scripts\python.exe -m scripts.demo_session
# Put only the demo_session value here. This variable is server-only.
GRABSPARK_DEMO_SESSION=
# Copy X-CSRF-Token from the same backend script output. Server-only; required for local writes.
GRABSPARK_DEMO_CSRF=
